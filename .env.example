PROJECT_NAME="Collaborative Event & Resource Booking Platform"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collaborative_booking_db

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/collaborative_booking_db

JWT_SECRET_KEY=replace-with-a-random-32-byte-hex-secret-key-in-production
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

PASSWORD_HASH_ALGORITHM=argon2

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

LOG_LEVEL=INFO
TIMEZONE=UTC
